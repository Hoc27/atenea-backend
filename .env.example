# ============================================================
# Instituto Atenea — Backend / Panel de administración
# Copia este archivo a `.env` y completa con valores reales.
# NUNCA subas `.env` con secretos reales al repositorio.
# ============================================================

# --- Base de datos (Prisma) ---
# SQLite para desarrollo local. En producción usa Postgres, ej:
#   postgresql://user:pass@localhost:5432/atenea?schema=public
DATABASE_URL="file:./dev.db"

# --- Servidor ---
PORT=4000
HOST=0.0.0.0

# Origen permitido para CORS (el frontend). En producción, la URL real del sitio.
# Sin "/" final. Se admiten varios separados por coma.
# Ej. producción: https://atenea.inventario.services
CORS_ORIGIN=http://localhost:3000

# --- Seguridad ---
# Secreto para firmar los JWT. Usa un valor largo y aleatorio (openssl rand -hex 64).
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Entorno: development | production. En production las cookies son Secure.
NODE_ENV=development

# --- Admin inicial (se usa SOLO en el seed) ---
ADMIN_EMAIL=admin@institutoatenea.edu.pa
ADMIN_PASSWORD=CambiarEstaClave_123!
ADMIN_NAME=Administrador

# --- Admisiones (formulario digital) ---
# Correo al que llegan las solicitudes de inscripción.
ADMISSION_EMAIL=admisiones@institutoatenea.edu.pa
# Remitente verificado en Resend (debe ser del dominio verificado).
FROM_EMAIL=no-reply@institutoatenea.edu.pa
# API key de Resend (https://resend.com/api-keys). Si se omite, el formulario
# se guarda en la BD pero NO se envía correo.
RESEND_API_KEY=

// Instituto Atenea — Esquema de datos (Prisma)
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  deletedAt    DateTime? // baja lógica: impide el login sin borrar el registro
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContentBlock {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DownloadCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  downloads Download[]
}

model Download {
  id          String            @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  mimeType    String
  size        Int
  categoryId  String?
  category    DownloadCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order       Int               @default(0)
  published   Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  category    String?
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  images      Media[]
}

model Media {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  area      String?
  order     Int      @default(0)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model AdmissionRequest {
  id           String    @id @default(cuid())
  /// @pii @purpose interes_legitimo
  studentName  String
  /// @pii @purpose interes_legitimo
  level        String?
  /// @pii @purpose contrato
  contactEmail String?
  /// @sensitive  PII y categorías especiales (menores, salud, religión), cifrado en `data`
  data         Json
  status       String    @default("new")
  deletedAt    DateTime? // marca de anonimización (Art. 17)
  restrictedAt DateTime? // limitación del tratamiento (Art. 18)
  createdAt    DateTime  @default(now())
}

enum DsarType {
  ACCESS
  RECTIFICATION
  ERASURE
  RESTRICTION
  PORTABILITY
  OBJECTION
}

enum DsarStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

/// Solicitud de derechos del titular (Art. 15-22). Sin relación a propósito,
/// para sobrevivir a la anonimización del titular.
model DataSubjectRequest {
  id         String     @id @default(uuid())
  type       DsarType
  status     DsarStatus @default(RECEIVED)
  /// Identificador del titular sin datos sensibles (p. ej. email de contacto).
  subjectRef String?
  receivedAt DateTime   @default(now())
  dueAt      DateTime
  completedAt DateTime?
  notes      String?

  @@index([status, dueAt])
}

/// Registro de auditoría append-only (solo INSERT desde la aplicación).
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  at            DateTime @default(now())
  principalId   String?
  principalRole String?
  action        String
  entity        String?
  entityId      String?
  requestId     String?
  ipTrunc       String?
  meta          Json?

  @@index([principalId, at])
  @@index([entity, entityId, at])
}
